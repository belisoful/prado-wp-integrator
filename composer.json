{
	"name": "belisoful/prado-wp-integrator",
	"type": "prado4-extension",
	"description": "Integrates Wordpress into PRADO",
	"keywords": [
		"prado",
		"wordpress",
		"integration",
		"extension"
	],
	"homepage": "https://github.com/belisoful/prado-wp-integrator",
	"license": "MIT",
	"authors": [
		{
			"name": "Brad Anderson",
			"email": "belisoful@icloud.com",
			"role": "Software Engineer",
			"homepage": "https://github.com/belisoful"
		}
	],
	"autoload": {
		"psr-4": {
			"PradoWpIntegrator\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PradoWpIntegrator\\TestTools\\": "tests/test_tools/"
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://asset-packagist.org"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"php": ">=8.2.0",
		"pradosoft/prado": "^4.3@dev"
	},
	"require-dev": {
		"phpunit/phpunit": "^10",
		"phpdocumentor/shim": "^3",
		"friendsofphp/php-cs-fixer": "^3.94",
		"phpstan/phpstan": "^2.1",
		"php-stubs/wordpress-stubs": "^7.0",
		"roots/wordpress": "^7.0"
	},
	"suggest": {
		"roots/wordpress": "Installs WordPress core via Composer (core only, no bundled themes); point WPDirectory at the install dir"
	},
	"config": {
		"platform": {
			"php": "8.2"
		},
		"allow-plugins": {
			"phpdocumentor/shim": true,
			"roots/wordpress-core-installer": true
		}
	},
	"scripts": {
		"unittest": "vendor/bin/phpunit --testsuite unit",
		"coverage": "php tests/test_tools/coverage.php"
	},
	"extra": {
		"bootstrap": "PradoWpIntegrator\\WPIntegratorModule",
		"wordpress-install-dir": "wordpress"
	}
}
